{
  "name": "@elenchi/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/cli.ts",
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "lint": "eslint src test --ext .ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@elenchi/shared": "workspace:*",
    "@fastify/cors": "9.0.1",
    "@fastify/multipart": "8.3.1",
    "@fastify/static": "7.0.4",
    "better-sqlite3": "11.3.0",
    "drizzle-orm": "0.33.0",
    "fastify": "4.28.1",
    "zod": "3.23.8",
    "mdast-util-to-string": "4.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.11",
    "@types/mdast": "4.0.4",
    "@types/node": "20.16.10",
    "drizzle-kit": "0.24.2",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  }
}
